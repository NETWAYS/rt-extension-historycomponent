<&| /Widgets/TitleBox, title => loc('My last [_1] tickets', scalar @tickets), class => 'fullwidth' &>

<div class="table-responsive">
<table class="table <% RT->Config->Get('TableAccent') %> collection-as-table">

    <thead>
    <tr>
        <th class="collection-as-table text-end">#</th>
        <th class="collection-as-table"><% loc('Subject') %></th>
        <th class="collection-as-table"><% loc('Status') %></th>
        <th class="collection-as-table"><% loc('Queue') %></th>
        <th class="collection-as-table"><% loc('Last Seen') %></th>
    </tr>
    </thead>

    <tbody>
% for my $entry (@tickets) {
%   my ($Ticket, $timestamp) = @$entry;
%   my $link = RT->Config->Get('WebPath') . '/Ticket/Display.html?id=' . $Ticket->Id;
%   my $subject = $Ticket->Subject || loc('(No subject)');
%   my $short = length $subject > 30 ? substr($subject, 0, 30) . '...' : $subject;
    <tr>
        <td class="collection-as-table text-end"><a href="<% $link %>"><% $Ticket->Id %></a></td>
        <td class="collection-as-table"><a href="<% $link %>" title="<% $subject %>"><% $short %></a></td>
        <td class="collection-as-table"><% loc($Ticket->Status) %></td>
        <td class="collection-as-table"><% $Ticket->QueueObj->Name %></td>
        <td class="collection-as-table"><% $now->DiffAsString($timestamp) %></td>
    </tr>
% }
    </tbody>

</table>
</div>

</&>

<%init>

return unless $session{'CurrentUser'} && $session{'CurrentUser'}->Id;

my $attribute = $session{'CurrentUser'}->FirstAttribute('RecentlyViewedTickets')
    or return;
my $data_ref = $attribute->Content;
return unless ref $data_ref eq 'ARRAY';

my @tickets;
for my $entry (@$data_ref) {
    next unless ref $entry eq 'ARRAY';
    my ($ticketId, $timestamp) = @$entry;
    my $Ticket = RT::Ticket->new($session{'CurrentUser'});
    $Ticket->Load($ticketId);
    next unless $Ticket->Id && $Ticket->CurrentUserCanSee;
    push @tickets, [$Ticket, $timestamp];
}

my $now = RT::Date->new($session{'CurrentUser'});

$now->SetToNow();

</%init>
